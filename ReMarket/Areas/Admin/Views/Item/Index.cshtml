@using ReMarket.Models
@{
    ViewData["Title"] = "All items";
    var status = Context.Request.Query["status"].ToString();
    string ActiveClass(string key) => status.Equals(key, StringComparison.OrdinalIgnoreCase) || (string.IsNullOrEmpty(status) && key == "all") ? "active" : "";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h1 class="h4 mb-0"><i class="bi bi-box-seam me-2"></i>Audit Items</h1>
    </div>
    <div class="card-body">
        <ul class="list-group list-group-horizontal-sm flex-wrap mb-3">
            <li class="list-group-item @ActiveClass("all")">
                <a asp-action="Index" class="text-decoration-none text-dark">All</a>
            </li>
            @foreach (var st in Enum.GetValues<ItemStatus>())
            {
                <li class="list-group-item @ActiveClass(st.ToString())">
                    <a asp-action="Index" asp-route-status="@st" class="text-decoration-none text-dark">@st</a>
                </li>
            }
        </ul>

        @Html.AntiForgeryToken()

        <table id="tblData" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Seller</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/item.js" asp-append-version="true"></script>
}

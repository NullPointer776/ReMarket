@using ReMarket.Utility
@{
    ViewData["Title"] = "Order List";
    var status = Context.Request.Query["status"].ToString().ToLower();
    string ActiveClass(string key) => status == key || (string.IsNullOrEmpty(status) && key == "all") ? "active" : "";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h1 class="h4 mb-0"><i class="bi bi-receipt me-2"></i>Order Management</h1>
    </div>
    <div class="card-body">
        <ul class="list-group list-group-horizontal-sm flex-wrap mb-3">
            <li class="list-group-item @ActiveClass("all")">
                <a asp-action="Index" class="text-decoration-none text-dark">All</a>
            </li>
            <li class="list-group-item @ActiveClass("pending")">
                <a asp-action="Index" asp-route-status="pending" class="text-decoration-none text-dark">Pending</a>
            </li>
            <li class="list-group-item @ActiveClass("approved")">
                <a asp-action="Index" asp-route-status="approved" class="text-decoration-none text-dark">Approved</a>
            </li>
            <li class="list-group-item @ActiveClass("inprocess")">
                <a asp-action="Index" asp-route-status="inprocess" class="text-decoration-none text-dark">Processing</a>
            </li>
            <li class="list-group-item @ActiveClass("completed")">
                <a asp-action="Index" asp-route-status="completed" class="text-decoration-none text-dark">Shipped</a>
            </li>
        </ul>

        <table id="tblData" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Order Status</th>
                    <th>Payment Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/order.js" asp-append-version="true"></script>
}

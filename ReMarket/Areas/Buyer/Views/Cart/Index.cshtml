@using ReMarket.Utility
@model ReMarket.Models.ViewModel.ShoppingCartVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h1 class="h4 mb-0"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h1>
    </div>
    <div class="card-body">
        @if (!Model.ShoppingCartList.Any())
        {
            <p class="text-muted mb-0">Your cart is empty.</p>
            <a asp-area="Buyer" asp-controller="Item" asp-action="Index" class="btn btn-outline-primary btn-sm mt-3">
                Continue Shopping
            </a>
        }
        else
        {
            @foreach (var cart in Model.ShoppingCartList)
            {
                <div class="row border-bottom pb-3 mb-3 align-items-center">
                    <div class="col-md-2 col-4">
                        <partial name="_ItemImageGallery" model="@(new ReMarket.Models.ViewModel.ItemImageGalleryViewModel {
                            ImageUrls = ItemGallery.GetAllImageUrls(cart.Item),
                            AltText = cart.Item.Name,
                            GalleryId = $"cart-{cart.Id}",
                            Mode = ReMarket.Models.ViewModel.ItemImageGalleryMode.Compact
                        })" />
                    </div>
                    <div class="col-md-5 col-8">
                        <h5 class="mb-1">@cart.Item.Name</h5>
                        <p class="text-muted small mb-0">
                            @(string.IsNullOrEmpty(cart.Item.Description)
                                ? "No description"
                                : (cart.Item.Description.Length > 80 ? cart.Item.Description[..80] + "…" : cart.Item.Description))
                        </p>
                    </div>
                    <div class="col-md-2 col-4 text-md-center">
                        <span class="text-muted small d-block">Unit price</span>
                        @cart.Item.Price.ToString("C")
                    </div>
                    <div class="col-md-2 col-4">
                        <div class="d-flex align-items-center gap-2">
                            <a asp-action="Minus" asp-route-cartId="@cart.Id" class="btn btn-outline-secondary btn-sm" title="Decrease quantity">−</a>
                            <span class="fw-semibold">@cart.Count</span>
                            <a asp-action="Plus" asp-route-cartId="@cart.Id" class="btn btn-outline-secondary btn-sm" title="Increase quantity">+</a>
                        </div>
                    </div>
                    <div class="col-md-1 col-4 text-end text-md-center">
                        <span class="fw-semibold">@cart.Price.ToString("C")</span>
                    </div>
                    <div class="col-md-1 col-4 text-end">
                        <a asp-action="Remove" asp-route-cartId="@cart.Id" class="btn btn-outline-danger btn-sm" title="Remove from cart">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                <a asp-area="Buyer" asp-controller="Item" asp-action="Index" class="btn btn-outline-primary text-uppercase btn-sm">
                    <small>Continue Shopping</small>
                </a>
                <div class="text-end">
                    <p class="mb-2 h5">Total: <span class="text-primary">@Model.OrderHeader.OrderTotal.ToString("C")</span></p>
                    <a asp-action="Summary" class="btn btn-primary">
                        Proceed to Summary <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@model IEnumerable<OrderHeader>
@{
    ViewData["Title"] = "My orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My orders</h1>
    <a asp-area="Buyer" asp-controller="Item" asp-action="Index" class="btn btn-outline-secondary btn-sm">Continue shopping</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">You have not placed any orders yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate.ToString("g")</td>
                        <td>@order.OrderStatus</td>
                        <td>@order.PaymentStatus</td>
                        <td class="text-end">@order.OrderTotal.ToString("C")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-orderId="@order.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

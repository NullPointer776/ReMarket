  @model Item
@{
    ViewData["Title"] = "List an item";
}

<h1 class="h3 mb-3">List an item for sale</h1>

<form asp-area="Seller" asp-controller="Item" asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-lg-10">
            <div class="border p-3 mb-3">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label"></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Condition" class="form-label"></label>
                    <select asp-for="Condition" asp-items="Html.GetEnumSelectList<Condition>()" class="form-select"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="DeliveryOption" class="form-label"></label>
                    <select asp-for="DeliveryOption" asp-items="Html.GetEnumSelectList<DeliveryOption>()" class="form-select"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                        <option value="">Select a category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="imageFileInput">Item images (1 to @ReMarket.Utility.ItemGallery.MaxImages)</label>
                    <div class="d-flex gap-2 align-items-start flex-wrap">
                        <input id="imageFileInput" name="imageFiles" type="file" class="form-control w-auto flex-grow-1" accept="image/*" multiple
                               data-val="true" data-val-required="Please select at least one image." />
                        <button type="button" class="btn btn-outline-secondary" onclick="openCamera('imageFileInput')">
                            <i class="bi bi-camera"></i> Take Photo
                        </button>
                    </div>
                    <span class="text-danger" data-valmsg-for="imageFiles" data-valmsg-replace="true"></span>
                    <div class="form-text">jpg / png / gif / webp, max 5 MB each. First image is the cover on listings.</div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Submit for review</button>
            <a asp-action="Index" class="btn btn-link">Back</a>
        </div>
        <div class="col-lg-2">
            <div class="border rounded p-2 bg-light sticky-top">
                <span class="form-label d-block small text-muted">Listing preview</span>
                <partial name="_ItemImageGallery" model="@(new ReMarket.Models.ViewModel.ItemImageGalleryViewModel {
                    ImageUrls = Array.Empty<string>(),
                    AltText = "Listing preview",
                    GalleryId = "listing-preview",
                    Mode = ReMarket.Models.ViewModel.ItemImageGalleryMode.Detail
                })" />
            </div>
        </div>
    </div>
</form>

<partial name="_CameraCapture" />


    <script src="~/js/item-gallery.js" asp-append-version="true"></script>
    <script>
        $(function () {
            $.validator.unobtrusive.parse(document);
        });
    </script>
}